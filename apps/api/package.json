{
  "name": "@app/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "build": "wrangler deploy --dry-run --outdir dist",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "policy:build": "opa build -t wasm -e agent/call/decision -o policies/bundle.tar.gz policies/decision.rego && tar -xzf policies/bundle.tar.gz -C policies /policy.wasm && rm policies/bundle.tar.gz",
    "policy:test": "opa test policies/"
  },
  "dependencies": {
    "@ai-sdk/openai": "4.0.104",
    "@ai-sdk/policy-opa": "1.0.155",
    "@open-policy-agent/opa": "2.0.0",
    "@open-policy-agent/opa-wasm": "1.10.0",
    "@slack/web-api": "7.16.0",
    "ai": "7.0.155",
    "bash-tool": "1.3.17",
    "exa-js": "1.10.3",
    "hono": "^4.13.0",
    "just-bash": "3.0.1",
    "workers-ai-provider": "4.0.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@app/eslint-config": "workspace:*",
    "@app/tsconfig": "workspace:*",
    "@cloudflare/workers-types": "^5.20261006.1",
    "typescript": "^5.8.3",
    "wrangler": "^4.151.0"
  }
}
